# Vorlage für die Zugangsdaten des Webspace.
#
# Kopieren, ausfüllen, nicht ins Repo legen:
#   cp deploy.env.example deploy.env
# `deploy.env` ist per .gitignore ausgeschlossen.
#
# Die Umgebung hat Vorrang: Variablen, die schon gesetzt sind (z. B. in
# GitHub Actions), werden von dieser Datei nicht überschrieben.

# Übertragungsweg: sftp, ftp oder ftps
DEPLOY_PROTOCOL=sftp

# Server, auf den hochgeladen wird
DEPLOY_HOST=

# Port; leer lassen heißt 22 bei sftp und 21 bei ftp/ftps
DEPLOY_PORT=

# Zugang
DEPLOY_USER=
DEPLOY_PASSWORD=

# Zielordner auf dem Server, z. B. /htdocs/galerie
DEPLOY_PATH=

# Was hochgeladen wird, relativ zum Projektordner
DEPLOY_SOURCE=_site

# 1 löscht auf dem Server alles, was lokal fehlt — prüfe DEPLOY_PATH, bevor
# du das einschaltest. Standard 0 lädt nur hoch und löscht nichts.
DEPLOY_DELETE=0

# Optional: Pfad zu einem SSH-Key für sftp statt Passwort
DEPLOY_SSH_KEY=

# Optional: andere Konfigurationsdatei statt ./deploy.env
DEPLOY_ENV_FILE=

# Abbruch, wenn die Übertragung länger braucht (Sekunden); Standard 600
DEPLOY_TIMEOUT=
